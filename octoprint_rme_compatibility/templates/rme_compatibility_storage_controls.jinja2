<section class="rme-file-browser">
    <div class="rme-file-toolbar">
        <div class="rme-file-navigation">
            <button type="button" class="btn btn-mini" data-bind="click: storageParent, enable: storageParentVisible() && !storageBatchBusy()">Up</button>
            <code data-bind="text: storage().path || '/'"></code>
            <button type="button" class="btn btn-mini" data-bind="click: refreshStorage, enable: state().supported && !storageBatchBusy()">Refresh</button>
            <button type="button" class="btn btn-mini" data-bind="click: storageMkdir, enable: storage().supported && !storageBatchBusy()">New folder…</button>
        </div>
        <div class="rme-file-selection">
            <input type="search" aria-label="Filter current USB folder" placeholder="Filter this folder…" data-bind="textInput: storageFilter">
            <span data-bind="text: storageSelectedEntries().length + ' selected'"></span>
            <button type="button" class="btn btn-mini" data-bind="click: storageMoveSelected, enable: storageSelectedEntries().length && !storageBatchBusy()">Move selected…</button>
            <button type="button" class="btn btn-mini btn-danger" data-bind="click: storageDeleteSelected, enable: storageSelectedEntries().length && !storageBatchBusy()">Delete selected…</button>
        </div>
    </div>
    <p role="status" data-bind="text: storageStatus, css: {'text-error': storage().error}"></p>
    <fieldset class="rme-file-entries" data-bind="disable: storageBatchBusy">
    <table class="table table-condensed rme-storage-table" data-bind="visible: storage().supported">
        <thead><tr><th class="rme-file-checkbox"><input type="checkbox" aria-label="Select all visible entries" data-bind="checked: storageAllSelected"></th><th>Name</th><th>Type/size</th><th>Actions</th></tr></thead>
        <tbody data-bind="foreach: storageVisibleEntries"><tr>
            <td><input type="checkbox" data-bind="checkedValue: path, checked: $parent.storageSelectedPaths, attr: {'aria-label': 'Select ' + name}"></td>
            <td>
                <a href="#" data-bind="visible: type === 'dir', text: name, click: $parent.storageOpen"></a>
                <span data-bind="visible: type !== 'dir', text: name"></span>
            </td>
            <td data-bind="text: $parent.storageFileSize($data)"></td>
            <td><div class="rme-storage-actions">
                <div class="rme-action-group">
                    <button type="button" class="btn btn-mini" data-bind="visible: type === 'file', click: $parent.storageDownloadToPi">Download to Pi</button>
                    <button type="button" class="btn btn-mini" data-bind="visible: type === 'file', click: $parent.storageDownloadToDevice">Download to device</button>
                    <button type="button" class="btn btn-mini" data-bind="visible: $parent.storageCanPrint($data), click: $parent.storagePrint">Print…</button>
                    <button type="button" class="btn btn-mini btn-danger" data-bind="visible: $parent.storageCanFlash($data), click: $parent.storageFlash">Flash…</button>
                </div>
                <div class="rme-action-group rme-action-group-secondary">
                    <button type="button" class="btn btn-mini" data-bind="click: $parent.storageRename">Rename…</button>
                    <button type="button" class="btn btn-mini" data-bind="click: $parent.storageMove">Move…</button>
                    <button type="button" class="btn btn-mini btn-danger" data-bind="click: $parent.storageDelete">Delete…</button>
                </div>
            </div></td>
        </tr></tbody>
    </table>
    </fieldset>
    <p class="help-block" data-bind="visible: storage().supported && !storageEntries().length">This directory is empty.</p>
    <p class="help-block" data-bind="visible: storageEntries().length && !storageVisibleEntries().length">No matching entries.</p>
    <details class="rme-file-upload">
        <summary>Upload to this USB folder</summary>
        <input type="file" data-bind="event: {change: chooseStorageUpload}">
        <button type="button" class="btn" data-bind="click: uploadStorage, enable: pendingStorageUpload() && !storageBatchBusy()">Upload to current directory</button>
        <p class="help-block">Uploads verify SHA-256 before replacing the destination.</p>
    </details>
    <div data-bind="visible: storageDownloadJob().id">
        <div class="progress progress-striped" data-bind="css: {active: storageDownloadActive}">
            <div class="bar" data-bind="style: {width: storageDownloadWidth}"></div>
        </div>
        <p class="help-block" data-bind="text: storageDownloadSummary, css: {'text-error': storageDownloadJob().status === 'error'}"></p>
    </div>
    <div data-bind="visible: storageDownloads().length">
        <h5>Files stored on this Pi</h5>
        <table class="table table-condensed">
            <tbody data-bind="foreach: storageDownloads"><tr>
                <td data-bind="text: name"></td>
                <td data-bind="text: $parent.storageFileSize({type: 'file', size: size})"></td>
                <td><button type="button" class="btn btn-mini" data-bind="click: $parent.downloadCachedStorageFile">Download to device</button></td>
                <td><button type="button" class="btn btn-mini btn-danger" data-bind="click: $parent.deleteCachedStorageFile">Delete from Pi</button></td>
            </tr></tbody>
        </table>
    </div>
    <details class="rme-file-recovery">
        <summary>Advanced: recover an interrupted upload</summary>
        <input type="text" placeholder="jobs/original-name.bgcode" data-bind="value: partialCleanupPath, enable: !partialTransfer()">
        <button type="button" class="btn" data-bind="click: cleanupNamedPartial, enable: partialCleanupPath() && !partialTransfer()">Clean exact partial…</button>
        <p class="help-block">Enter the original final USB path. This removes only its derived <code>.rme-part</code> and <code>.rme-meta</code> siblings, never <code>.rme-old</code>.</p>
    </details>
</section>
    <hr>
