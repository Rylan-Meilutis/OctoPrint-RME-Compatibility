<div class="rme-panel">
    <div class="rme-status-line">
        <span class="label" data-bind="css: connectionClass, text: connectionText"></span>
        <span class="rme-active-tool" data-bind="visible: activeToolVisible, attr: {title: activeToolText}">
            <span class="rme-color-dot" data-bind="style: {backgroundColor: activeToolColor}"></span>
            <strong data-bind="text: activeToolText"></strong>
        </span>
    </div>

    <div class="rme-card" data-bind="visible: workflowVisible">
        <h4><span data-bind="text: workflowTitle"></span> <small data-bind="text: workflowState"></small></h4>
        <div class="progress progress-striped" data-bind="css: {active: workflowIndeterminate}">
            <div class="bar" data-bind="style: {width: workflowWidth}"></div>
        </div>
        <p class="rme-workflow-message" data-bind="text: workflowMessage"></p>
        <small data-bind="text: workflowTiming"></small>
    </div>

    <div class="rme-card rme-prompt" data-bind="visible: hasFirmwarePrompt">
        <h4><span data-bind="text: workflowTitle"></span>: action required</h4>
        <p data-bind="text: promptMessage"></p>
        <div data-bind="foreach: promptActions">
            <button class="btn" data-bind="text: $data, click: $parent.respond"></button>
        </div>
    </div>

    <div class="rme-card rme-prompt" data-bind="visible: pendingNewSpool">
        <h4>Configure filament selected on printer</h4>
        <p>The printer selected a new or unlinked material for tool <strong data-bind="text: pendingNewSpool() && pendingNewSpool().tool"></strong>. This form survives refreshes.</p>
        <div class="form-inline rme-spool-form">
            <label>Name <input class="input-medium" data-bind="value: newSpoolName"></label>
            <label>Vendor <input class="input-small" data-bind="value: newSpoolVendor"></label>
            <label>Material <input class="input-small" data-bind="value: newSpoolMaterial"></label>
            <label>Color <input type="color" data-bind="value: newSpoolColor"></label>
            <label>Color name <input class="input-small" data-bind="value: newSpoolColorName"></label>
            <label>Initial weight <input class="input-small" type="number" min="1" data-bind="value: newSpoolWeight"> g</label>
            <label>Nozzle <input class="input-mini" type="number" min="0" max="500" data-bind="value: newSpoolNozzle"> °C</label>
            <label>Bed <input class="input-mini" type="number" min="0" max="500" data-bind="value: newSpoolBed"> °C</label>
        </div>
        <button class="btn btn-primary" data-bind="click: createSpool">Create, select, and sync</button>
        <button class="btn" data-bind="click: cancelNewSpool">Dismiss</button>
    </div>

    <div class="rme-card rme-prompt" data-bind="visible: pendingProviderSync">
        <h4>Filament provider changed</h4>
        <p data-bind="text: pendingProviderSync() && pendingProviderSync().message"></p>
        <button class="btn btn-primary" data-bind="click: confirmProviderSync">Apply provider selections to printer</button>
        <button class="btn" data-bind="click: cancelProviderSync">Keep printer selections</button>
        <p class="help-block">This prompt persists across refreshes. Keeping the printer selections reads them back into the active provider.</p>
    </div>

    <div class="rme-card">
        <h4>Filament and tool state</h4>
        <p><span class="label" data-bind="css: {'label-success': spoolmanager().available, 'label-warning': !spoolmanager().available}, text: spoolmanagerStatus"></span></p>
        <p class="alert alert-info" data-bind="visible: externalSpoolProvider, text: spoolOwnershipText"></p>
        <ul data-bind="visible: internalSpoolProvider, foreach: publishedSpools">
            <li><span class="rme-color-dot" data-bind="style: {backgroundColor: color}"></span> <span data-bind="text: $parent.spoolLabel($data)"></span></li>
        </ul>
        <p data-bind="visible: selectedSpools().length"><strong>Loaded assignments:</strong>
            <span data-bind="foreach: selectedSpools"><span class="rme-assignment" data-bind="text: 'T' + tool + ': ' + display_name"></span></span>
        </p>
        <p data-bind="visible: loadedFilaments().length"><strong>Printer-reported loadout:</strong>
            <span data-bind="foreach: loadedFilaments"><span class="rme-assignment"><span class="rme-color-dot" data-bind="style: {backgroundColor: color}"></span> <span data-bind="text: $parent.loadedFilamentLabel($data)"></span></span></span>
        </p>
        <p><small>Inventory management and synchronization controls are in RME Compatibility Settings.</small></p>
    </div>

    <div class="rme-card rme-prompt" data-bind="visible: hasToolmapPrompt, event: {focusin: touchToolmap, mousedown: touchToolmap, keydown: touchToolmap}">
        <h4>Tool mapping before print</h4>
        <p data-bind="text: promptMessage"></p>
        <p><small data-bind="text: toolmapTimeoutText"></small></p>
        <table class="table table-condensed">
            <thead><tr><th>Logical tool</th><th>Use physical tool</th></tr></thead>
            <tbody data-bind="foreach: mappingRows">
                <tr>
                    <td data-bind="text: 'T' + logical"></td>
                    <td>
                        <select class="input-small" data-bind="options: $parent.physicalTools, value: physical, optionsText: function(i) { return 'Tool ' + i; }"></select>
                    </td>
                </tr>
            </tbody>
        </table>
        <label class="checkbox"><input type="checkbox" data-bind="checked: mappingEnabled"> Enable remapping</label>
        <button class="btn btn-primary" data-bind="click: applyToolmap">Apply mapping and continue print</button>
        <button class="btn" data-bind="click: resetToolmap">Use default mapping and continue</button>
        <p class="help-block">No print-file G-code is sent until this mapping is confirmed. Validation runs afterward against the remapped physical tools.</p>
    </div>

    <div class="rme-card" data-bind="visible: hasMachine">
        <h4>Discovered machine</h4>
        <p data-bind="text: machineSummary"></p>
        <p><strong>Current theme:</strong>
            <span data-bind="visible: !currentThemeRows().length">Not reported yet</span>
            <span data-bind="foreach: currentThemeRows">
                <span class="rme-theme-current"><span class="rme-color-dot" data-bind="style: {backgroundColor: color}"></span> <span data-bind="text: label + ' ' + color"></span></span>
            </span>
        </p>
        <p data-bind="text: currentLightsText"></p>
    </div>

    <div class="rme-card" data-bind="visible: statsRows().length">
        <h4>RME printer statistics</h4>
        <p>Lifetime and print counters reported directly by the firmware.</p>
        <dl class="dl-horizontal" data-bind="foreach: statsRows">
            <dt data-bind="text: label"></dt><dd data-bind="text: value"></dd>
        </dl>
    </div>

</div>
